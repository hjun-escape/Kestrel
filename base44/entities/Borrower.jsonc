{
  "name": "Borrower",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "website_domain": {
      "type": "string"
    },
    "hq_city": {
      "type": "string"
    },
    "hq_state": {
      "type": "string"
    },
    "industry": {
      "type": "string"
    },
    "stage": {
      "type": "string",
      "enum": [
        "applicant",
        "borrower"
      ],
      "default": "borrower"
    },
    "loan_amount_usd": {
      "type": "number"
    },
    "linkedin_url": {
      "type": "string"
    },
    "glassdoor_url": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "green",
        "yellow",
        "red"
      ]
    },
    "why": {
      "type": "string"
    },
    "last_refreshed": {
      "type": "string",
      "format": "date-time"
    },
    "last_attempted": {
      "type": "string",
      "format": "date-time",
      "description": "Written only by refreshBorrower when a check starts, successful or not. The refresh cooldown counts from it so failed or overlapping checks are not repeated. Not shown on screens."
    },
    "sources_unavailable": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "News",
          "Legal",
          "Jobs",
          "Reviews"
        ]
      }
    },
    "owner_email": {
      "type": "string",
      "description": "Email of the signed-in user who added the company. Empty = the shared demo book, shown only to signed-out visitors. Signed-in users see and use only their own companies. Set on create (client: AddCompanyDialog; server: confirmAction from auth.me()); never changed afterwards."
    },
    "profile_search": {
      "type": "object",
      "description": "Written only by findCompanyPages: outcome of the automatic LinkedIn / Glassdoor page lookup for website_domain (user, found, not_found or error per page). A domain already settled is not searched again.",
      "properties": {
        "linkedin": { "type": "string", "enum": ["user", "found", "not_found", "error"] },
        "glassdoor": { "type": "string", "enum": ["user", "found", "not_found", "error"] },
        "domain": { "type": "string" },
        "checked_at": { "type": "string", "format": "date-time" }
      }
    },
    "pending_snapshots": {
      "type": "object",
      "description": "Written only by refreshBorrower: Bright Data snapshot_id per signal function that is still building, passed back on the next refresh. Not shown on screens.",
      "properties": {
        "newsSignals": {
          "type": "string"
        },
        "hiringSignal": {
          "type": "string"
        },
        "reviewSignals": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "name",
    "website_domain",
    "stage",
    "status"
  ],
  "rls": { "create": false, "read": false, "update": false, "delete": false }
}
