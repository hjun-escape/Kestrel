{
  "name": "Borrower",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "website_domain": {
      "type": "string"
    },
    "hq_city": {
      "type": "string"
    },
    "hq_state": {
      "type": "string"
    },
    "industry": {
      "type": "string"
    },
    "stage": {
      "type": "string",
      "enum": [
        "applicant",
        "borrower"
      ],
      "default": "borrower"
    },
    "loan_amount_usd": {
      "type": "number"
    },
    "linkedin_url": {
      "type": "string"
    },
    "glassdoor_url": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "green",
        "yellow",
        "red"
      ]
    },
    "why": {
      "type": "string"
    },
    "last_refreshed": {
      "type": "string",
      "format": "date-time"
    },
    "sources_unavailable": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "News",
          "Legal",
          "Jobs",
          "Reviews"
        ]
      }
    },
    "pending_snapshots": {
      "type": "object",
      "description": "Written only by refreshBorrower: Bright Data snapshot_id per signal function that is still building, passed back on the next refresh. Not shown on screens.",
      "properties": {
        "newsSignals": {
          "type": "string"
        },
        "hiringSignal": {
          "type": "string"
        },
        "reviewSignals": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "name",
    "website_domain",
    "stage",
    "status"
  ]
}