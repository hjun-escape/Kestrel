{
  "name": "Analysis",
  "type": "object",
  "properties": {
    "borrower_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          },
          "source_url": {
            "type": "string"
          },
          "source_name": {
            "type": "string"
          },
          "date": {
            "type": "string"
          }
        }
      }
    },
    "findings_dropped": {
      "type": "number"
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommended_action": {
      "type": "string",
      "enum": [
        "proceed",
        "request_documents",
        "escalate"
      ]
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tool": {
            "type": "string"
          },
          "input": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "borrower_id",
    "created_at",
    "summary",
    "recommended_action"
  ]
}
