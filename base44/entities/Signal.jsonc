{
  "name": "Signal",
  "type": "object",
  "properties": {
    "borrower_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "hiring_drop",
        "review_distress",
        "exec_departure",
        "legal_layoffs"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "strong",
        "weak"
      ]
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "date_approx": {
      "type": "boolean",
      "description": "Written by newsSignals: the date came from Google's relative \"N weeks/months/years ago\", so it is approximate."
    },
    "title": {
      "type": "string"
    },
    "snippet": {
      "type": "string"
    },
    "source_name": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    }
  },
  "required": [
    "borrower_id",
    "type",
    "severity",
    "date",
    "title"
  ]
}